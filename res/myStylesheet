body {
    margin: 0;
    padding: 0;
    height: 100vh;
    background: #1e1e1e;
    font-family: sans-serif;
    color: white;
}

#app-container {
    display: flex;
    flex-direction: row;
    height: 100vh;
    width: 100vw;
}

#game-section {
    width: 60%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111;
}

#controls-section {
    width: 40%;
    display: flex;
    flex-direction: column;
    border-left: 4px solid #333;
    background: white; /* Blockly needs a white background */
}

#blocklyDiv {
    flex-grow: 1;
    width: 100%;
}

.run-btn {
    padding: 15px;
    font-size: 18px;
    background: #22c55e;
    color: white;
    border: none;
    font-weight: bold;
    cursor: pointer;
}

.run-btn:hover {
    background: #16a34a;
}

#game-board {
    position: relative;  /* CRITICAL: Allows the robot to move via absolute positioning */
    display: grid;
    width: 600px;        /* Matches the 600/gridSize math in your JS */
    height: 600px;       /* Matches the 600/gridSize math in your JS */
    gap: 2px;
    background: #444;
    border: 4px solid #555;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

.cell {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    width: 100%;
    height: 100%;
}

/* Map Textures */
.water { background: #3b82f6; }
.path { background: #d97706; }
.target { background: #22c55e; }
.wall { background: #525252; border: 2px solid #333; }

#robot {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: bold;
    z-index: 10;
    transition: all 0.4s ease-in-out;
}

@media (max-width: 1024px) {
    #app-container {
        flex-direction: column; /* Stacks the game on top, code on bottom */
    }
    
    #game-section {
        width: 100%;
        height: 55vh; 
    }
    
    #controls-section {
        width: 100%;
        height: 45vh; 
        border-left: none;
        border-top: 4px solid #333;
    }

    /* Scales the board down so it fits on a phone screen without breaking JS math */
    #game-board {
        transform: scale(0.6); 
    }
}

@media (max-width: 600px) {
    #game-board {
        transform: scale(0.45); /* Scales even smaller for narrow phones */
    }
}